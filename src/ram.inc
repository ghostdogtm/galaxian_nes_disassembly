; RAM labels. Generated by tools/disasm.py from tools/labels/ram.txt
; name = $address ; usage count in code ; comment

mpVramLo               = $0000 ; 4 ; music player: PPU address low byte of the next note
mpNote                 = $0001 ; 2 ; music player: current note byte (lo nibble SQ1, hi nibble SQ2)
mpVramHi               = $0002 ; 2 ; music player: PPU address high byte of the song
mpStarted              = $0003 ; 2 ; music player: nonzero after the APU was initialised
mpTempoMask            = $0004 ; 2 ; music player: a note is read when (frameCounter & mask) == 0
micPrev                = $0023 ; 3 ; previous $4016 value (bit 2 = Famicom microphone)
micShoutCount          = $0024 ; 2 ; microphone toggles; 4 + resetCounter 10 -> music player
alienCount             = $0027 ; 4 ; aliens left in the formation (CountAliens, one column per frame)
alienCountTmp          = $0028 ; 4 ; CountAliens accumulator
playerSwitched         = $0029 ; 3 ; set by SwapPlayers; WipeIfPlayerSwitched wipes the screen once
nmiBusy                = $002A ; 3 ; set during NMI; an NMI that finds it set resets the game (watchdog)
gameOverTimer          = $002B ; 3 ; 2P: $78 frames of "GAME OVER PLAYER n" before the other player continues
deathDelay             = $002C ; 2 ; DeathStep2: $3C frames after the "PLAYER n" text
hudRedrawIndex         = $002D ; 3 ; UpdateHudScores: next HUD tile pair to queue (0-$15)
wipeRowSet             = $002E ; 3 ; ScreenWipe: 0 = WipeRowsTitle (story), 1 = WipeRowsGame (InitNewGame)
titleScrollTimer       = $002F ; 5 ; title scroll-in: $EF frames
menuHoldTimer          = $0030 ; 4 ; title menu: Start/Select must be held 3 frames
menuSelect             = $0031 ; 5 ; title menu: bit 0 = 1P / 2P
unused32               = $0032 ; 1 ; only written (0) by TitleInit
wipeTimer              = $0033 ; 4 ; ScreenWipe column 31..1
sq1HiLast              = $0034 ; 2 ; last value written to SQ1_HI (rewrite only on change)
flagshipAttackTimer    = $0035 ; 5 ; set to $96 by FlagshipAttackTimer, counts down per frame; the attack starts at $4E
textVram               = $0036 ; 13 ; (size 2) PrintText: PPU address of the text row
vramRowPtr             = $0038 ; 9 ; (size 2) WriteVramRow: source of the 26 bytes
rngSeed                = $003A ; 2 ; incremented while waiting for vblank; added into randomTable every NMI
rngSeed2               = $003B ; 1 ; incremented when rngSeed wraps; never read
twoPlayerGame          = $003C ; 5 ; nonzero in a 2-player game until one player is out
extraLifePending       = $003D ; 5 ; nonzero until the 5000-point extra life is given (per player)
otherExtraLifePending  = $003E ; 3 ; same for the waiting player
flagshipBonusTimer     = $003F ; 4 ; $B4 after a flagship is shot; no enemy fire meanwhile
shotSound              = $0040 ; 4 ; player shot sound step (UpdateShotSound clears it after one step - TCRF bug)
explosionSound         = $0041 ; 5 ; player explosion: noise period 6..$0D, 0 = off
lives                  = $0042 ; 13 ; GameHacking.org: lives
otherLives             = $0043 ; 4 ; lives of the player who is waiting (2P game)
autoFireTimer          = $0044 ; 2 ; GameHacking.org "auto-fire" 0044:01; CheckFireButton fires when it counts down to 0
curJoy                 = $004C ; 11 ; buttons of the current player (synthesized by the demo AI in attract mode)
pauseFlag              = $004E ; 3 ; nonzero = game paused (Start)
playerState            = $004F ; 19 ; GameHacking.org "invincible": 004F:00; 0 = ship in play, 1-$21 explosion, $21 = waiting to spawn
explTileLo             = $0050 ; 3 ; UpdateBgTiles: player explosion tile address
explRow                = $0051 ; 3 ; UpdateBgTiles: player explosion row 3..0
curPlayer              = $0053 ; 10 ; bit 0 = which player is playing (2P game)
scoreAdd               = $0054 ; 3 ; (size 5) digits to add (scoreAdd+3 = hundreds, +4 = tens), see AddScore
stage                  = $0059 ; 12 ; GameHacking.org: stage modifier
otherStage             = $005A ; 3 ; stage of the player who is waiting (2P game)
attackTimers           = $005B ; 4 ; (size 8) 8 counters (every 4 frames), each wraps at AttackTimerPeriods,X; DifficultyAttackMask picks which launch
secondTimer            = $0063 ; 3 ; frames 0-59
difficultyTimer        = $0064 ; 3 ; seconds 0-19: difficulty + 1 every 20 seconds (max 7)
difficulty             = $0065 ; 6 ; min(stage, 7) at the start of a wave, then grows with time
attackSide             = $0066 ; 2 ; bit 0: LaunchFromLeft / LaunchFromRight
flagshipAttackCount    = $0067 ; 3 ; 4-frame ticks up to FlagshipPeriod
diveSiren              = $0068 ; 5 ; $32 when a diver launches: siren while aliens dive
songPtr                = $006B ; 4 ; (size 2) MusicChannelUpdate: song data pointer (songTable,X*2 - $0840)
musRequest             = $006D ; 10 ; (size 4) per tune (0-3): start it; 0 extra life, 1 flagship hit, 2 alien hit, 3 game start.
musChannel             = $0071 ; 3 ; tune being updated (3..0)
musPos                 = $0072 ; 3 ; (size 4) per tune: position in the song
musTimer               = $0076 ; 6 ; (size 4) per tune: note duration counter; musTimer+3 (start tune) != 0 blocks the hum and SpawnPlayer
sndScratch             = $007E ; 7 ; (size 16) $7E-$8D cleared every frame by UpdateSound; $7E = 1 when a note starts
sq1PeriodLo            = $0080 ; 3 ; SQ1 period written by MusicChannelUpdate
sq1PeriodHi            = $0081 ; 2
flagshipRespawn        = $008E ; 12 ; (size 2) nonzero: a lone flagship escaped, it comes back in column 4/5 next wave (current player)
otherFlagshipRespawn   = $0090 ; 6 ; (size 2) same for the waiting player (swapped by SwapPlayers)
columnDivers           = $0092 ; 9 ; (size 10) number of diving aliens per formation column (keeps the column for FormationBounce)
modeTimer              = $009C ; 20 ; general timer: title menu, story text, delay after a wave
diverOam               = $009D ; 28 ; current diver slot * 16 (OAM offset)
diverSlot              = $009E ; 30 ; current diver slot (0-7)
waveCleared            = $009F ; 5 ; set by CheckFormationEmpty when all 10 columns are empty
eventQueue             = $00A0 ; 2 ; (size 32) ring buffer of formation columns to redraw
eventHead              = $00C0 ; 4 ; write index (QueueColumnRedraw)
eventTail              = $00C1 ; 4 ; read index (UpdateBgTiles)
flapTimer              = $00C2 ; 5 ; FormationFlapTimer: 9..0 = column to redraw, then down to -12
formation              = $00C3 ; 27 ; (size 10) column bitmasks (column 0 = left): bits 0-2 blue rows, 3 purple, 4 red, 5 flagship
formationOther         = $00CD ; 3 ; (size 10) formation of the player who is waiting (2P game)
redrawColumn           = $00D7 ; 5 ; column being redrawn by UpdateBgTiles
flapPhase              = $00D8 ; 2 ; formation wing animation phase (+1 after each full redraw)
tmp0                   = $00DA ; 26 ; $DA-$E0: temporaries shared by many routines
tmp1                   = $00DB ; 11
tmp2                   = $00DC ; 4
tmp3                   = $00DD ; 17 ; also the direction quadrant of a diver
tmp4                   = $00DE ; 21 ; also Divide8 divisor, demo fire flag
tmp5                   = $00DF ; 32 ; also Divide8 dividend
tmp6                   = $00E0 ; 92 ; also Divide8 result
vramQueueCount         = $00E1 ; 13 ; entries in the vramQueue* arrays (max 16), flushed in NMI
srcPtr                 = $00E2 ; 23 ; (size 2) PrintText: source of the text; RESET: destination of the CHR copies
playerX                = $00E4 ; 24 ; signed -$6A..+$6A, 0 = centre (ship X = playerX + $78); also the bottom scroll
formationX             = $00E5 ; 13 ; formation horizontal position (column X = col*16 + $30 + formationX)
jumpTablePtr           = $00E8 ; 4 ; (size 2) JumpTableDispatch: return address of the JSR (= table - 1)
jumpTarget             = $00EA ; 3 ; (size 2) JumpTableDispatch: jump target
motionTick             = $00EC ; 2 ; UpdateMotionSteps runs once per frameTick
frameTick              = $00ED ; 12 ; incremented once per GameModeDispatch
joy1Prev               = $00EE ; 3
joy1                   = $00EF ; 8 ; controller 1, bit 7 = A ... bit 0 = Right
joy2Prev               = $00F0 ; 1
joy2                   = $00F1 ; 3 ; controller 2 (A+B = $C0 enables the music player)
diverDirTmp            = $00F2 ; 2 ; MoveDiver: direction index (diverDir / 4)
scrollX                = $00F6 ; 3
scrollY                = $00F7 ; 11
ppuMaskShadow          = $00FA ; 2
ppuCtrlShadow          = $00FB ; 13
subStep                = $00FD ; 26 ; step inside a gameSubMode handler (death sequence, story text ...)
gameSubMode            = $00FE ; 38 ; index for the per-mode jump tables
gameMode               = $00FF ; 24 ; index into GameModeTable
stackPage              = $0100 ; 2 ; stack page base, STA stackPage,X
musicPlayerFlag        = $0101 ; 2 ; nonzero -> NMI runs MusicPlayer every frame. In REVA nothing sets it: ResetKeepSignature
frameCounter           = $0102 ; 7 ; (size 3) 24-bit, big-endian: $0102 high ... $0104 low
resetSignature         = $0105 ; 5 ; (size 16) copy of "HARUHISA UDAGAWA" (TCRF)
resetCounter           = $0115 ; 4 ; TCRF: number of warm resets; $2D (45) / $0A (10) enable the music player
scoreArea              = $0116 ; 15 ; (size 26) $0116-$012F, set to $10 (blank) at power-on; AddScore uses scoreArea,Y
scoreP1                = $0117 ; 1 ; (size 6) BCD digits, tile $10 = blank
hiScore                = $0120 ; 6 ; (size 6) 5000 after power-on
scoreP2                = $0129 ; 1 ; (size 6) 
oamBuffer              = $0200 ; 153 ; (size 256) sprite page for OAM DMA ($4014 = $02)
ramPage6               = $0600 ; 1 ; RESET clears $0600-$06FF (the text copy then overwrites $0600-$067F)
demoTargetX            = $068F ; 2 ; demo AI: X the ship walks to
hudBuffer              = $0690 ; 14 ; (size 44) HUD tiles for PPU $2074-$209F (two rows): 22 pairs queued one per frame by UpdateHudScores
hudScore               = $06A0 ; 4 ; (size 6) score of the current player shown in the HUD (hudScore+9 = hiScore copy)
hudLives               = $06B1 ; 1 ; (size 3) ship icons, lower half (tile $6F; upper half $6E at hudBuffer+1)
hudFlags               = $06B5 ; 3 ; (size 5) stage flag icons (lower half; upper half at hudBuffer+5)
hudStageTens           = $06B6 ; 1 ; stage number (stage >= 5) next to one flag; overlaps hudFlags+1
hudStageOnes           = $06B7 ; 1
textBuf                = $06BC ; 2 ; (size 26) one text row: PrintText fills it, WriteVramRow (NMI) copies it to textVram
textCharBias           = $06D6 ; 8 ; subtracted from the characters by PrintText ($30 or 0)
textNtFlag             = $06D7 ; 12 ; PrintText: nonzero = second nametable ($28xx); also a step counter of IntroTextSequence
randomTable            = $06D8 ; 5 ; (size 16) randomTable,X += rngSeed every NMI (X = frameTick & 15)
diverShots             = $06E8 ; 3 ; (size 8) bullets the diver may still fire (2, 3 from stage 1)
diverType              = $06F0 ; 11 ; (size 8) score index: formation row 0-5; escort 4; flagship 0 + 1 per escort launched or lost (bonus index)
diverEscort2           = $06F8 ; 13 ; (size 8) flagship: slot of the second escort
flagshipDir            = $06FF ; 4 ; -1 / +1: side of the flagship attack (= diverEscort2+7)
diverEscort1           = $0700 ; 15 ; (size 8) flagship: slot of the first escort
flagshipColumn         = $0707 ; 4 ; column of the attacking flagship (= diverEscort1+7)
diverIsFlagship        = $0708 ; 6 ; (size 8) $60 for a flagship (also its tile offset), else 0
diverDropY             = $0710 ; 5 ; (size 8) state 4/9: frames left while dropping back into the formation
diverRow               = $0718 ; 5 ; (size 8) formation row 0-5
diverColumn            = $0720 ; 5 ; (size 8) formation column 0-9
diverTile              = $0728 ; 7 ; (size 8) first tile of the 2x2 metasprite
diverDir               = $0730 ; 22 ; (size 8) direction 0-$5F (diverDir / 4 indexes the Dir* tables); a frame counter in states 11-12
diverState             = $0738 ; 26 ; (size 8) per diver slot: state for DiverStateDispatch
diverTargetX           = $0740 ; 9 ; (size 8) X where the dive turns back toward the ship
vramQueueTile2         = $0748 ; 6 ; (size 16) NMI queue: second tile
vramQueueTile1         = $0758 ; 6 ; (size 16) NMI queue: first tile
vramQueueLo            = $0768 ; 6 ; (size 16) NMI queue: PPU address low
vramQueueHi            = $0778 ; 6 ; (size 16) NMI queue: PPU address high
motionDir              = $0788 ; 15 ; (size 24) bit 7 = negative; GameHacking.org "enemy shooting affected" 078D:00 = motionDir+5
formationDir           = $079F ; 3 ; bit 7 = moving left (= motionDir+23), flipped by FormationBounce
motionDiv              = $07A0 ; 17 ; (size 24) divisor: speed = motionNum / motionDiv px per frame; 0 = object idle
motionNum              = $07B8 ; 21 ; (size 24) numerator, added to motionRem every frame
motionRem              = $07D0 ; 14 ; (size 24) remainder of the division (sub-pixel position)
motionStep             = $07E8 ; 17 ; (size 23) signed pixels per frame, computed by UpdateMotionSteps
formationDx            = $07FF ; 4 ; formation drift per frame (= motionStep+23)
